<?xml version="1.0"?>
<robot name="rocket">
  <material name="blue">
    <color rgba="0.175 0.277 0.906 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20"/>
      <inertia ixx="16.25" ixy="0" ixz="0"
               iyy="16.25" iyz="0"
               izz="2.5"/>
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.5" length="3.0"/>
      </geometry>
    </collision>

    <!-- Main Body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.5" length="3.0"/>
      </geometry>
      <material name="blue"/>
    </visual>

  </link>

  <link name="thrust_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.0001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="thrust_joint" type="fixed">
    <origin xyz="0.0 0.0 -1.5" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="thrust_link"/>
    <axis xyz="0.0 0.0 0.0"/>
    <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

</robot>
